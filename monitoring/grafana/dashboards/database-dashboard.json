{
  "title": "Database Overview",
  "uid": "db-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "description": "Note: is dashboard ke liye mysqld_exporter ya postgres_exporter chalu hona chahiye aur prometheus.yml me 'database' job uncomment karna hoga.",
  "panels": [
    {
      "id": 1,
      "title": "Active Connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "mysql_global_status_threads_connected", "legendFormat": "MySQL connections" },
        { "expr": "pg_stat_activity_count", "legendFormat": "Postgres connections" }
      ]
    },
    {
      "id": 2,
      "title": "Queries per Second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "rate(mysql_global_status_queries[5m])", "legendFormat": "MySQL QPS" },
        { "expr": "rate(pg_stat_database_xact_commit[5m])", "legendFormat": "Postgres commits/sec" }
      ]
    },
    {
      "id": 3,
      "title": "Slow Queries",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "rate(mysql_global_status_slow_queries[5m])", "legendFormat": "slow queries/sec" }
      ]
    },
    {
      "id": 4,
      "title": "Buffer Pool / Cache Hit Ratio (%)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "(1 - (mysql_global_status_innodb_buffer_pool_reads / mysql_global_status_innodb_buffer_pool_read_requests)) * 100",
          "legendFormat": "InnoDB cache hit %"
        }
      ]
    },
    {
      "id": 5,
      "title": "Database Uptime",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "mysql_global_status_uptime", "legendFormat": "uptime (sec)" }
      ]
    }
  ]
}
