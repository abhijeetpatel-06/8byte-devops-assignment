#!/usr/bin/env bash
# ============================================================
# config.env
# ------------------------------------------------------------
# Ye single file hai jaha pe sara server-specific data rakha hai.
# Naya server setup karna ho to sirf yahi file edit karo, baaki
# scripts/configs me haath lagane ki zarurat nahi padegi.
#
# NOTE: Ye file "source" hoti hai scripts se (install_*.sh,
# apply_config.sh, setup.sh), isliye isme valid bash syntax hi
# rakhna - koi space around "=" nahi.
# ============================================================

# ---- Server ----
# Ye wo IP hai jisse Grafana/Prometheus URLs aur Loki client
# apna data bhejenge. Agar localhost pe hi sab kuch chala rahe ho
# to 127.0.0.1 bhi chalega, but production me actual private IP daalo.
SERVER_IP="192.168.1.100"
SERVER_HOSTNAME="monitoring-server-01"

# ---- Prometheus ----
PROMETHEUS_VERSION="2.53.0"
PROMETHEUS_PORT="9090"
PROMETHEUS_DATA_DIR="/var/lib/prometheus"
PROMETHEUS_CONFIG_DIR="/etc/prometheus"
PROMETHEUS_RETENTION="15d"       # data kitne din tak rakhna hai, storage dekh ke adjust karna
SCRAPE_INTERVAL="15s"
EVAL_INTERVAL="15s"

# ---- Node Exporter (server ke CPU/RAM/Disk metrics ke liye) ----
NODE_EXPORTER_VERSION="1.8.2"
NODE_EXPORTER_PORT="9100"

# ---- Alertmanager ----
ALERTMANAGER_VERSION="0.27.0"
ALERTMANAGER_PORT="9093"
ALERTMANAGER_CONFIG_DIR="/etc/alertmanager"
ALERTMANAGER_DATA_DIR="/var/lib/alertmanager"

# Alerts kaha bhejne hain - Slack (webhook) ya Email, jo bhi use
# nahi karna use blank chhod do, alertmanager.yml me condition hai.
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/XXXX/XXXX/XXXXXXXXXXXXXXXXXXXX"
SLACK_CHANNEL="#server-alerts"

SMTP_HOST="smtp.gmail.com:587"
SMTP_USER="alerts@example.com"
SMTP_PASSWORD="changeme_app_password"
ALERT_EMAIL_FROM="alerts@example.com"
ALERT_EMAIL_TO="devops-team@example.com"

# ---- Loki + Promtail (logs) ----
LOKI_VERSION="2.9.8"
LOKI_PORT="3100"
LOKI_CONFIG_DIR="/etc/loki"
LOKI_DATA_DIR="/var/lib/loki"

PROMTAIL_VERSION="2.9.8"
PROMTAIL_CONFIG_DIR="/etc/promtail"
# Jo bhi log files bhejni hain wo yaha add karte jao, comma-separated
# nahi - promtail-config.yml me already common paths (syslog, nginx,
# app logs) daale hain, bas path adjust karna apne app ke hisaab se.
APP_LOG_PATH="/var/log/myapp/*.log"

# ---- Grafana ----
GRAFANA_PORT="3000"
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="ChangeThisPassword123!"

# ============================================================
# Bas. Isse neeche kuch mat likhna, scripts yahi tak parse karte hain.
# ============================================================
