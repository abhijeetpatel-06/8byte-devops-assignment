[Unit]
Description=Alertmanager - Prometheus se alerts leke route karta hai (slack/email)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=alertmanager
Group=alertmanager
ExecStart=/usr/local/bin/alertmanager \
    --config.file=__ALERTMANAGER_CONFIG_DIR__/alertmanager.yml \
    --storage.path=__ALERTMANAGER_DATA_DIR__ \
    --web.listen-address=0.0.0.0:__ALERTMANAGER_PORT__

Restart=on-failure
RestartSec=5

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
