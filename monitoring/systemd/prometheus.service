[Unit]
Description=Prometheus - metrics collection ka server
Documentation=https://prometheus.io/docs/introduction/overview/
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=prometheus
Group=prometheus
# --storage.tsdb.retention.time yaha hardcode nahi kiya, apply_config.sh
# ye placeholder replace karti hai config.env ke PROMETHEUS_RETENTION se
ExecStart=/usr/local/bin/prometheus \
    --config.file=__PROMETHEUS_CONFIG_DIR__/prometheus.yml \
    --storage.tsdb.path=__PROMETHEUS_DATA_DIR__ \
    --storage.tsdb.retention.time=__PROMETHEUS_RETENTION__ \
    --web.listen-address=0.0.0.0:__PROMETHEUS_PORT__ \
    --web.enable-lifecycle

Restart=on-failure
RestartSec=5
# thoda sa buffer, kabhi kabhi bade config reload pe time lagta hai
TimeoutStopSec=20

# basic hardening - zaroorat se zyada permissions nahi chahiye isko
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
