# Copy this to terraform.tfvars and fill in your own values.
# DO NOT commit terraform.tfvars (or anything with real passwords) to git.

aws_region   = "ap-south-1"
project_name = "myapp"
environment  = "prod"

vpc_cidr              = "10.0.0.0/16"
az_count              = 2
public_subnet_cidrs   = ["10.0.0.0/24", "10.0.1.0/24"]
private_subnet_cidrs  = ["10.0.10.0/24", "10.0.11.0/24"]
single_nat_gateway    = true

instance_type        = "t3.micro"
key_pair_name        = ""
app_port             = 8080
asg_min_size         = 2
asg_max_size         = 4
asg_desired_capacity = 2

db_engine_version        = "16.4"
db_instance_class        = "db.t3.micro"
db_allocated_storage     = 20
db_name                  = "myappdb"
db_username              = "myapp_admin"
# db_password should NOT go here - export it as an env var instead:
#   export TF_VAR_db_password="your-strong-password-here"
db_multi_az              = false
db_deletion_protection   = false
